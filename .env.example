# Run npm run setup:local to create ignored .env with random local-only secrets.
DATABASE_URL=
DB_PASSWORD=
DB_PORT=5433
WEB_URL=http://localhost:5173
API_URL=http://localhost:3001
API_PORT=3001
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=LabSphere <no-reply@labsphere.test>
MAILPIT_PORT=8025
SESSION_SECRET=
CSRF_HEADER=x-csrf-token
STORAGE_ROOT=.local/private-files
DEV_SEED_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
TIMEZONE=Asia/Bangkok
# Optional provider configuration; disabled in local build.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
